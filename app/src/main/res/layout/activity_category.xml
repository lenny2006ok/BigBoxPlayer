<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- Sidebar (Left Column) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSidebar"
        android:layout_width="240dp"
        android:layout_height="0dp"
        android:background="#1A1A1A"
        android:padding="8dp"
        android:nextFocusRight="@+id/recyclerItems"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Items Grid (Right Column) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:nextFocusLeft="@+id/recyclerSidebar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/recyclerSidebar"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Loading Overlay -->
    <ProgressBar
        android:id="@+id/loadingCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#f8b774"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>