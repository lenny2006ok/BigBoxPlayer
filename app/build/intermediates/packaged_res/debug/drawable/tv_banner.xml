<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo Vermelho com Cantos Arredondados -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#91033D" />
            <!-- Adicionado Cantos Arredondados -->
            <corners android:radius="50dp" />
            <!-- Força o formato retangular 16:9 na TV -->
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>

    <!-- O Logo com as suas configurações de margem -->
    <item
        android:top="110dp"
        android:bottom="110dp"
        android:left="400dp"
        android:right="400dp"
        android:drawable="@drawable/logo" />
</layer-list>